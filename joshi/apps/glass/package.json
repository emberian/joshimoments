{
  "name": "@joshi/glass",
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:paired-inspect": "VITE_JOSHI_ORDINARY_PAIRING=1 vite --host 127.0.0.1",
    "dev:g0-inspect": "VITE_JOSHI_G0_INSPECTOR=1 vite --host 127.0.0.1",
