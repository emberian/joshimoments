#!/bin/sh
set -eu

JOSHI_REPO=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$JOSHI_REPO"

JOSHI_W5_CREATED_STATE=0
if [ "${JOSHI_W5_STATE:-}" = "" ]; then
  JOSHI_W5_STATE=$(mktemp -d /tmp/joshi-wave5-readiness.XXXXXX)
  JOSHI_W5_CREATED_STATE=1
fi
case "$JOSHI_W5_STATE" in
  /tmp/joshi-wave5-readiness.*) ;;
  *)
    echo "JOSHI_W5_STATE must be an explicit /tmp/joshi-wave5-readiness.* directory" >&2
    exit 2
    ;;
esac
export JOSHI_W5_STATE
UV_CACHE_DIR="$JOSHI_W5_STATE/uv-cache"
UV_OFFLINE=1
export UV_CACHE_DIR UV_OFFLINE

cleanup() {
  if [ "$JOSHI_W5_CREATED_STATE" -eq 1 ]; then
    echo "wave5 fixture witness retained at $JOSHI_W5_STATE/wave5-witness.json" >&2
  fi
}
trap cleanup EXIT HUP INT TERM

# Preserve the complete root structural gate. Its Wave 4 result remains historical evidence and
# is not rewritten by this script.
JOSHI_W4_STATE=$(mktemp -d /tmp/joshi-wave4-readiness.XXXXXX)
export JOSHI_W4_STATE
./scripts/wave4-readiness \
  > "$JOSHI_W5_STATE/wave4-witness.json"

# This command walks semantic run registration plus one sealed public C0 origin segment through
# store receipt, run-bound catalog closure, durable catalog ACK and restart readback. It is not the
# full Phase-0 fault walk and cannot set a live/product maturity bit.
mkdir -p "$JOSHI_W5_STATE/ignition"
cargo run --locked --offline -p joshi-core -- wave5-ignition-readiness \
  --state "$JOSHI_W5_STATE/ignition" > "$JOSHI_W5_STATE/ignition-readiness.json"

# Exercise the joined offline G0 component without promoting it to the complete 37-scenario root
# walk: sole-store source semantics, headed Cockpit V2 publication, partial memory, nonempty V10
# export/import, exact export recovery, artifact-bearing backup/restore, and restart readback.
mkdir -p "$JOSHI_W5_STATE/g0"
cargo run --locked --offline -p joshi-core -- wave5-g0-source-publication \
  --state "$JOSHI_W5_STATE/g0" > "$JOSHI_W5_STATE/g0-source-publication.json"

jq -e '
  .contract == "joshi.wave5.g0_source_publication_readiness"
  and .status == "useful_partial"
  and .catalogSchema == "joshi.sqlite.v10"
  and .sourceSemanticsClosed == true
  and .publicationPrepareBodyHeadClosed == true
  and .partialMemoryChainClosed == true
  and .baselineExportImportClosed == true
  and .nonemptyV10ExportClosed == true
  and .v10ExportRecoveryClosed == true
  and .partialBackupRestoreClosed == true
  and .restartReverified == true
  and (.partialFaultResult.evidenceBundle.items | length) == 15
  and (.partialFaultResult.evidenceBundle.digest | test("^sha256:[0-9a-f]{64}$"))
  and (.v10ExportSnapshotId | test("^sha256:[0-9a-f]{64}$"))
  and .fullOfflineFaultWalk == false
  and .providerIo == false
  and .productQualified == false
  and .liveQualified == false
' "$JOSHI_W5_STATE/g0-source-publication.json" > /dev/null

JOSHI_IGNITION_SHA=$(shasum -a 256 "$JOSHI_W5_STATE/ignition-readiness.json" | awk '{print $1}')
JOSHI_G0_SHA=$(shasum -a 256 "$JOSHI_W5_STATE/g0-source-publication.json" | awk '{print $1}')
JOSHI_MIGRATION_SHA=$(shasum -a 256 schema/migrations/0009_wave5_living_instrument.sql | awk '{print $1}')
JOSHI_G0_MIGRATION_SHA=$(shasum -a 256 schema/migrations/0010_wave5_g0_store_spine.sql | awk '{print $1}')
JOSHI_G0_EVIDENCE_SHA=$(jq -er '.partialFaultResult.evidenceBundle.digest' "$JOSHI_W5_STATE/g0-source-publication.json")
JOSHI_G0_SNAPSHOT_ID=$(jq -er '.v10ExportSnapshotId' "$JOSHI_W5_STATE/g0-source-publication.json")

printf '%s\n' "{\"contract\":\"joshi.wave5.living_instrument_witness\",\"schemaVersion\":3,\"authority\":\"read_only_no_execution\",\"status\":\"useful_partial\",\"circulationWalkDigest\":\"sha256:$JOSHI_IGNITION_SHA\",\"g0ComponentDigest\":\"sha256:$JOSHI_G0_SHA\",\"g0EvidenceBundleDigest\":\"$JOSHI_G0_EVIDENCE_SHA\",\"g0SnapshotId\":\"$JOSHI_G0_SNAPSHOT_ID\",\"catalogMigrationDigest\":\"sha256:$JOSHI_MIGRATION_SHA\",\"g0CatalogMigrationDigest\":\"sha256:$JOSHI_G0_MIGRATION_SHA\",\"attainedCapabilities\":[\"run_registered\",\"public_c0_spool_catalog_closed\",\"component_restart_readback\",\"store_resolved_fixture_source\",\"headed_cockpit_v2_publication\",\"partial_scientific_memory\",\"nonempty_v10_export_import\",\"v10_export_recovered\",\"artifact_bearing_backup_restore\",\"g0_component_28_prefix_recovery\"],\"qualification\":{\"fullOfflineFaultWalk\":false,\"boundedNonfixture\":false,\"restartRecovered\":false,\"sustainedObserved\":false,\"liveReadOnly\":false,\"preliminaryEmberUse\":false,\"criticalSurfaceAccessibility\":false,\"broadParity\":false},\"claim\":\"offline_run_registration_public_c0_and_partial_g0_component_closure_only\"}" \
  > "$JOSHI_W5_STATE/wave5-witness.json"

cat "$JOSHI_W5_STATE/wave5-witness.json"
