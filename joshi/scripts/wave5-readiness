#!/bin/sh
set -eu

JOSHI_REPO=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$JOSHI_REPO"

JOSHI_W5_CREATED_STATE=0
if [ "${JOSHI_W5_STATE:-}" = "" ]; then
  JOSHI_W5_STATE=$(mktemp -d /tmp/joshi-wave5-readiness.XXXXXX)
  JOSHI_W5_CREATED_STATE=1
fi
case "$JOSHI_W5_STATE" in
  /tmp/joshi-wave5-readiness.*) ;;
  *)
    echo "JOSHI_W5_STATE must be an explicit /tmp/joshi-wave5-readiness.* directory" >&2
    exit 2
    ;;
esac
export JOSHI_W5_STATE
UV_CACHE_DIR="$JOSHI_W5_STATE/uv-cache"
UV_OFFLINE=1
export UV_CACHE_DIR UV_OFFLINE

cleanup() {
  if [ "$JOSHI_W5_CREATED_STATE" -eq 1 ]; then
    echo "wave5 fixture witness retained at $JOSHI_W5_STATE/wave5-witness.json" >&2
  fi
}
trap cleanup EXIT HUP INT TERM

# Preserve the complete root structural gate. Its Wave 4 result remains historical evidence and
# is not rewritten by this script.
JOSHI_W4_STATE=$(mktemp -d /tmp/joshi-wave4-readiness.XXXXXX)
export JOSHI_W4_STATE
./scripts/wave4-readiness \
  > "$JOSHI_W5_STATE/wave4-witness.json"

# This command walks semantic run registration plus one sealed public C0 origin segment through
# store receipt, run-bound catalog closure, durable catalog ACK and restart readback. It is not the
# full Phase-0 fault walk and cannot set a live/product maturity bit.
mkdir -p "$JOSHI_W5_STATE/ignition"
cargo run --locked --offline -p joshi-core -- wave5-ignition-readiness \
  --state "$JOSHI_W5_STATE/ignition" > "$JOSHI_W5_STATE/ignition-readiness.json"

# Exercise and join the offline G0 component with the ordinary-pairing HTTP open/restart path. The
# result closes all eighteen baseline evidence roles over one run/source/publication, but it does
# not promote itself to the complete 37-scenario root fault walk.
mkdir -p "$JOSHI_W5_STATE/g0"
cargo run --locked --offline -p joshi-core -- wave5-g0-root-evidence \
  --state "$JOSHI_W5_STATE/g0" > "$JOSHI_W5_STATE/g0-root-evidence.json"

jq -e '
  .contract == "joshi.wave5.g0_root_evidence.v1"
  and .status == "useful_partial"
  and .authority == "offline_fixture_evidence_no_fault_qualification"
  and .runRegistrationId == .component.runRegistrationId
  and .runRegistrationId == .inspector.runRegistrationId
  and .runRegistrationDigest == .component.runRegistrationDigest
  and .runRegistrationDigest == .inspector.runRegistrationDigest
  and .publicationId == .component.publicationId
  and .publicationId == .inspector.publicationId
  and .publicationDigest == .component.publicationDigest
  and .publicationDigest == .inspector.publicationDigest
  and .component.contract == "joshi.wave5.g0_source_publication_readiness"
  and .inspector.contract == "joshi.wave5.g0_inspector_smoke"
  and .component.catalogSchema == "joshi.sqlite.v10"
  and .component.sourceSemanticsClosed == true
  and .component.publicationPrepareBodyHeadClosed == true
  and .component.censoredMemoryChainClosed == true
  and .component.memoryClosureCount == 6
  and .component.memoryQueueThrough == 8
  and .component.nonemptyV10ExportClosed == true
  and .component.v10ExportRecoveryClosed == true
  and .component.partialBackupRestoreClosed == true
  and .component.restartReverified == true
  and .inspector.pairedRouteReadClosed == true
  and .inspector.restartOldCapabilityRefused == true
  and .inspector.freshPairingReopenClosed == true
  and .inspector.routeResponseDigest == .inspector.reopenedResponseDigest
  and .partialRootEvidenceClosed == true
  and (.evidenceBundle.items | length) == 18
  and [.evidenceBundle.items[].role] == [
    "reservation", "origin_segment", "store_receipt", "catalog_binding", "catalog_ack",
    "semantic_fact", "publication_prepare", "publication_head", "pairing_exchange",
    "glass_read", "memory_act", "memory_episode", "export_manifest", "import_receipt",
    "status_readback", "backup_manifest", "restore_readback", "reopen_readback"
  ]
  and (.componentReportDigest | test("^sha256:[0-9a-f]{64}$"))
  and (.inspectorReportDigest | test("^sha256:[0-9a-f]{64}$"))
  and (.evidenceBundle.digest | test("^sha256:[0-9a-f]{64}$"))
  and (.v10ExportSnapshotId | test("^sha256:[0-9a-f]{64}$"))
  and .fullOfflineFaultWalk == false
  and .component.fullOfflineFaultWalk == false
  and .inspector.fullOfflineFaultWalk == false
  and .component.providerIo == false
  and .browserPresented == false
  and .productQualified == false
  and .liveQualified == false
' "$JOSHI_W5_STATE/g0-root-evidence.json" > /dev/null

JOSHI_IGNITION_SHA=$(shasum -a 256 "$JOSHI_W5_STATE/ignition-readiness.json" | awk '{print $1}')
JOSHI_G0_ROOT_SHA=$(shasum -a 256 "$JOSHI_W5_STATE/g0-root-evidence.json" | awk '{print $1}')
JOSHI_G0_SHA=$(jq -er '.componentReportDigest' "$JOSHI_W5_STATE/g0-root-evidence.json")
JOSHI_G0_INSPECTOR_SHA=$(jq -er '.inspectorReportDigest' "$JOSHI_W5_STATE/g0-root-evidence.json")
JOSHI_MIGRATION_SHA=$(shasum -a 256 schema/migrations/0009_wave5_living_instrument.sql | awk '{print $1}')
JOSHI_G0_MIGRATION_SHA=$(shasum -a 256 schema/migrations/0010_wave5_g0_store_spine.sql | awk '{print $1}')
JOSHI_G0_EVIDENCE_SHA=$(jq -er '.evidenceBundle.digest' "$JOSHI_W5_STATE/g0-root-evidence.json")
JOSHI_G0_SNAPSHOT_ID=$(jq -er '.v10ExportSnapshotId' "$JOSHI_W5_STATE/g0-root-evidence.json")

printf '%s\n' "{\"contract\":\"joshi.wave5.living_instrument_witness\",\"schemaVersion\":5,\"authority\":\"read_only_no_execution\",\"status\":\"useful_partial\",\"circulationWalkDigest\":\"sha256:$JOSHI_IGNITION_SHA\",\"g0RootEvidenceDigest\":\"sha256:$JOSHI_G0_ROOT_SHA\",\"g0ComponentDigest\":\"$JOSHI_G0_SHA\",\"g0InspectorSmokeDigest\":\"$JOSHI_G0_INSPECTOR_SHA\",\"g0EvidenceBundleDigest\":\"$JOSHI_G0_EVIDENCE_SHA\",\"g0SnapshotId\":\"$JOSHI_G0_SNAPSHOT_ID\",\"catalogMigrationDigest\":\"sha256:$JOSHI_MIGRATION_SHA\",\"g0CatalogMigrationDigest\":\"sha256:$JOSHI_G0_MIGRATION_SHA\",\"attainedCapabilities\":[\"run_registered\",\"public_c0_spool_catalog_closed\",\"component_restart_readback\",\"store_resolved_fixture_source\",\"headed_cockpit_v2_publication\",\"paired_fixture_api_reopen\",\"censored_scientific_memory\",\"nonempty_v10_export_import\",\"v10_export_recovered\",\"artifact_bearing_backup_restore\",\"g0_component_30_prefix_recovery\",\"partial_root_18_role_evidence\"],\"qualification\":{\"fullOfflineFaultWalk\":false,\"boundedNonfixture\":false,\"restartRecovered\":false,\"sustainedObserved\":false,\"liveReadOnly\":false,\"preliminaryEmberUse\":false,\"criticalSurfaceAccessibility\":false,\"broadParity\":false},\"claim\":\"offline_run_registration_public_c0_and_partial_g0_root_evidence_only\"}" \
  > "$JOSHI_W5_STATE/wave5-witness.json"

cat "$JOSHI_W5_STATE/wave5-witness.json"
