#!/bin/sh
set -eu

JOSHI_REPO=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$JOSHI_REPO"

JOSHI_W6_CREATED_STATE=0
if [ "${JOSHI_W6_STATE:-}" = "" ]; then
  JOSHI_W6_STATE=$(mktemp -d /tmp/joshi-wave6-foundation.XXXXXX)
  JOSHI_W6_CREATED_STATE=1
fi
case "$JOSHI_W6_STATE" in
  /tmp/joshi-wave6-foundation.*) ;;
  *)
    echo "JOSHI_W6_STATE must be an explicit /tmp/joshi-wave6-foundation.* directory" >&2
    exit 2
    ;;
esac
export JOSHI_W6_STATE

cleanup() {
  if [ "$JOSHI_W6_CREATED_STATE" -eq 1 ]; then
    echo "Wave 6 fixture witness retained at $JOSHI_W6_STATE/wave6-foundation-witness.json" >&2
  fi
}
trap cleanup EXIT HUP INT TERM

./schema/validate.sh
cargo test --locked --offline -p joshi-wave6-registry --all-targets
cargo test --locked --offline -p joshi-wave6-campaign --all-targets
cargo test --locked --offline -p joshi-store wave6 --lib
cargo test --locked --offline -p joshi-core wave6_registration --lib

mkdir -p "$JOSHI_W6_STATE/catalog"
cargo run --locked --offline -q -p joshi-core -- wave6-program-registration \
  --state "$JOSHI_W6_STATE/catalog" > "$JOSHI_W6_STATE/program-first.json"
cargo run --locked --offline -q -p joshi-core -- wave6-program-registration \
  --state "$JOSHI_W6_STATE/catalog" > "$JOSHI_W6_STATE/program-retry.json"

jq -e '
  .contract == "joshi.core.wave6_program_registration_report.v7"
  and .schemaVersion == 7
  and .status == "fixture_only"
  and .authority == "read_record_replay_propose_shadow_only"
  and .semanticCeiling == "unverified_semantic_fixture_only"
  and .catalogSchema == "joshi.sqlite.v17"
  and .programId == "w6-program-fixture-001"
  and (.registrationDigest | test("^sha256:[0-9a-f]{64}$"))
  and (.documentDigest | test("^sha256:[0-9a-f]{64}$"))
  and (.acceptedCommitSeq | test("^[1-9][0-9]*$"))
  and (.firstStatus == "accepted" or .firstStatus == "idempotent")
  and .retryStatus == "idempotent"
  and .registrationPersisted == true
  and .restartReverified == true
  and .registeredSchemaCount == "6"
  and [.schemas[].kindId] == [
    "campaign_registration_fixture",
    "known_truth_evaluation_fixture",
    "market_atlas_fixture",
    "protocol_known_truth_evaluation_fixture",
    "research_proposal_fixture",
    "structural_known_truth_evaluation_fixture"
  ]
  and ([.schemas[].schemaDigest]
    | all(test("^sha256:[0-9a-f]{64}$")))
  and ([.schemas[].commitSeq]
    | all(test("^[1-9][0-9]*$")))
  and .schemaCatalogPersisted == true
  and .schemaCatalogRestartReverified == true
  and .fixtureArtifactContentCount == "3"
  and [.fixtureArtifacts[].kindId] == [
    "known_truth_evaluation_fixture",
    "protocol_known_truth_evaluation_fixture",
    "structural_known_truth_evaluation_fixture"
  ]
  and [.fixtureArtifacts[].resultCount] == ["8", "7", "3"]
  and ([.fixtureArtifacts[].artifactId]
    | all(test("^wave6-artifact:[0-9a-f]{64}$")))
  and ([.fixtureArtifacts[].contentDigest,
        .fixtureArtifacts[].evaluationDigest]
    | flatten | all(test("^sha256:[0-9a-f]{64}$")))
  and ([.fixtureArtifacts[].commitSeq]
    | all(test("^[1-9][0-9]*$")))
  and .fixtureArtifactContentPersisted == true
  and .fixtureArtifactContentRestartReverified == true
  and (.fixtureArtifactDag.dagId | test("^wave6-dag:[0-9a-f]{64}$"))
  and .fixtureArtifactDag.dagDigest == "sha256:54c1773c3c0c29a9663bb5ad53b2d9b203a9dc8a1c7723935cabed74bc65ce09"
  and (.fixtureArtifactDag.documentDigest | test("^sha256:[0-9a-f]{64}$"))
  and .fixtureArtifactDag.artifactCount == "3"
  and .fixtureArtifactDag.maximumInformationCutoff == "2026-08-18T00:10:00.000000Z"
  and .fixtureArtifactDag.maximumProducedAt == "2026-08-18T00:32:00.000000Z"
  and (.fixtureArtifactDag.commitSeq | test("^[1-9][0-9]*$"))
  and .fixtureArtifactDagPersisted == true
  and .fixtureArtifactDagRestartReverified == true
  and (.fixtureDecisionLedger.ledgerId | test("^wave6-decisions:[0-9a-f]{64}$"))
  and .fixtureDecisionLedger.ledgerDigest == "sha256:9ed8f03224c75246e4ab34dee9cea8a939c4dc873faa8d7ff01afb0258813d09"
  and .fixtureDecisionLedger.documentDigest == "sha256:d11988aeac754fdb2417147e9edbc06a775055f0cf07b389bd616b82587fd432"
  and .fixtureDecisionLedger.decisionCount == "3"
  and .fixtureDecisionLedger.maximumDecidedAt == "2026-08-18T00:35:00.000000Z"
  and (.fixtureDecisionLedger.commitSeq | test("^[1-9][0-9]*$"))
  and .fixtureDecisionLedgerPersisted == true
  and .fixtureDecisionLedgerRestartReverified == true
  and (.fixtureCampaignBundle.bundleId | test("^wave6-campaign:[0-9a-f]{64}$"))
  and .fixtureCampaignBundle.campaignId == "campaign-fixture-001"
  and .fixtureCampaignBundle.registrationDigest == "sha256:bbda37eac723a4c3e50a4cff0e81a3c6793f1fe7d2bd6b2016e67bd6ad1b4303"
  and .fixtureCampaignBundle.enrollmentDigest == "sha256:b248e906cd3b979ec832958a41af31653c2a35539af90d3dd36ae0815904c95f"
  and .fixtureCampaignBundle.assignmentDigest == "sha256:88c6308ce02cf6efe73990379b43d13800e750085b468bb41f01878d07923a16"
  and .fixtureCampaignBundle.sealDigest == "sha256:80037edbb452a2226a95e71bd03d00a4cc92c418ecf5d6a06524b58df22cef4c"
  and .fixtureCampaignBundle.adjudicationDigest == "sha256:34029b56fdc3de042c8211b568e5effcb3f1f18fcde18c23577f08c1203985eb"
  and .fixtureCampaignBundle.bundleDigest == "sha256:e61f247eae51a1c644960ec3624dc251f6544b90644753c4c8a4917bb0f29461"
  and .fixtureCampaignBundle.eligibleSubjectCount == "3"
  and .fixtureCampaignBundle.includedSubjectCount == "2"
  and .fixtureCampaignBundle.assignmentCount == "2"
  and .fixtureCampaignBundle.outcomeCount == "2"
  and .fixtureCampaignBundle.maximumFixtureAllegedCommitSeq == "21"
  and (.fixtureCampaignBundle.commitSeq | test("^[1-9][0-9]*$"))
  and .fixtureCampaignBundlePersisted == true
  and .fixtureCampaignBundleRestartReverified == true
  and .prospectiveCampaignJournal == false
  and .fixtureResearchProposal.proposalId == "research-proposal-482af6e85fb9edae5a00eccf29af12b2"
  and .fixtureResearchProposal.proposalDigest == "sha256:482af6e85fb9edae5a00eccf29af12b24319e5b0ca2cce81fda3aceb9632d5c4"
  and .fixtureResearchProposal.contentDigest == "sha256:5da44fffda071866e79f80624ecece320884f69a598a582b4a5362c37d731503"
  and .fixtureResearchProposal.commitmentDigest == "sha256:b2ac507fe5b345e86597935cf0bf531ce724a47b1716a6fe34d3d324fc18074e"
  and .fixtureResearchProposal.policyDigest == "sha256:2496363c244f5d4f49dc884e2bd4efca50608986c1ad0f12d060b4646dd0a51b"
  and .fixtureResearchProposal.evidenceClosureDigest == "sha256:9fcff155013a8fd8121d6fccc377f0450c8ecc76e52b9be859b3f0fd7a0b0103"
  and .fixtureResearchProposal.descriptorCount == "3"
  and .fixtureResearchProposal.counterexampleCount == "18"
  and .fixtureResearchProposal.experimentCount == "1"
  and .fixtureResearchProposal.totalExperimentUnits == "3"
  and .fixtureResearchProposal.maximumFixtureAllegedCommitSeq == "12"
  and (.fixtureResearchProposal.maximumResolvedArtifactCommitSeq | test("^[1-9][0-9]*$"))
  and [.fixtureResearchProposal.artifactBindings[].resolvedKindId] == [
    "known_truth_evaluation_fixture",
    "protocol_known_truth_evaluation_fixture",
    "structural_known_truth_evaluation_fixture"
  ]
  and [.fixtureResearchProposal.artifactBindings[].fixtureAllegedCommitSeq] == ["10", "11", "12"]
  and ([.fixtureResearchProposal.artifactBindings[].resolvedArtifactCommitSeq]
    | all(test("^[1-9][0-9]*$")))
  and (.fixtureResearchProposal.commitSeq | test("^[1-9][0-9]*$"))
  and .fixtureResearchProposalPersisted == true
  and .fixtureResearchProposalRestartReverified == true
  and .humanResearchReview == false
  and .proposalExecuted == false
  and .researchResult == false
  and .consumedWave5GateCount == "0"
  and .providerUnits == "0"
  and .externalMutationUnits == "0"
  and .wave5GatesResolved == false
  and .operationalRelease == false
  and .empiricalClaim == false
  and .productQualified == false
  and .liveQualified == false
' "$JOSHI_W6_STATE/program-first.json" > /dev/null

jq -e --slurpfile first "$JOSHI_W6_STATE/program-first.json" '
  .firstStatus == "idempotent"
  and .retryStatus == "idempotent"
  and .acceptedCommitSeq == $first[0].acceptedCommitSeq
  and .registrationDigest == $first[0].registrationDigest
  and .documentDigest == $first[0].documentDigest
  and .schemas == $first[0].schemas
  and .fixtureArtifacts == $first[0].fixtureArtifacts
  and .fixtureArtifactDag == $first[0].fixtureArtifactDag
  and .fixtureDecisionLedger == $first[0].fixtureDecisionLedger
  and .fixtureCampaignBundle == $first[0].fixtureCampaignBundle
  and .fixtureResearchProposal == $first[0].fixtureResearchProposal
  and .fixtureResearchProposalPersisted == true
  and .fixtureResearchProposalRestartReverified == true
  and .humanResearchReview == false
  and .proposalExecuted == false
  and .researchResult == false
  and .prospectiveCampaignJournal == false
  and .wave5GatesResolved == false
  and .operationalRelease == false
  and .empiricalClaim == false
  and .productQualified == false
  and .liveQualified == false
' "$JOSHI_W6_STATE/program-retry.json" > /dev/null

JOSHI_W6_PROGRAM_SHA=$(shasum -a 256 "$JOSHI_W6_STATE/program-first.json" | awk '{print $1}')
JOSHI_W6_PROGRAM_MIGRATION_SHA=$(shasum -a 256 \
  schema/migrations/0011_wave6_program_registry.sql | awk '{print $1}')
JOSHI_W6_SCHEMA_MIGRATION_SHA=$(shasum -a 256 \
  schema/migrations/0012_wave6_artifact_schemas.sql | awk '{print $1}')
JOSHI_W6_ARTIFACT_MIGRATION_SHA=$(shasum -a 256 \
  schema/migrations/0013_wave6_fixture_artifacts.sql | awk '{print $1}')
JOSHI_W6_DAG_MIGRATION_SHA=$(shasum -a 256 \
  schema/migrations/0014_wave6_artifact_dag.sql | awk '{print $1}')
JOSHI_W6_DECISION_MIGRATION_SHA=$(shasum -a 256 \
  schema/migrations/0015_wave6_fixture_decisions.sql | awk '{print $1}')
JOSHI_W6_CAMPAIGN_MIGRATION_SHA=$(shasum -a 256 \
  schema/migrations/0016_wave6_campaign_bundle.sql | awk '{print $1}')
JOSHI_W6_RESEARCH_MIGRATION_SHA=$(shasum -a 256 \
  schema/migrations/0017_wave6_research_proposal.sql | awk '{print $1}')

jq -cn \
  --arg report "sha256:$JOSHI_W6_PROGRAM_SHA" \
  --arg program_migration "sha256:$JOSHI_W6_PROGRAM_MIGRATION_SHA" \
  --arg schema_migration "sha256:$JOSHI_W6_SCHEMA_MIGRATION_SHA" \
  --arg artifact_migration "sha256:$JOSHI_W6_ARTIFACT_MIGRATION_SHA" \
  --arg dag_migration "sha256:$JOSHI_W6_DAG_MIGRATION_SHA" \
  --arg decision_migration "sha256:$JOSHI_W6_DECISION_MIGRATION_SHA" \
  --arg campaign_migration "sha256:$JOSHI_W6_CAMPAIGN_MIGRATION_SHA" \
  --arg research_migration "sha256:$JOSHI_W6_RESEARCH_MIGRATION_SHA" \
  --slurpfile program "$JOSHI_W6_STATE/program-first.json" '
  {
    contract: "joshi.wave6.fixture_foundation_witness.v6",
    schemaVersion: 6,
    authority: "read_record_replay_propose_shadow_only",
    status: "fixture_only",
    semanticCeiling: "unverified_semantic_fixture_only",
    catalogSchema: $program[0].catalogSchema,
    programId: $program[0].programId,
    registrationDigest: $program[0].registrationDigest,
    programReportDigest: $report,
    programMigrationDigest: $program_migration,
    schemaMigrationDigest: $schema_migration,
    artifactMigrationDigest: $artifact_migration,
    dagMigrationDigest: $dag_migration,
    decisionMigrationDigest: $decision_migration,
    campaignMigrationDigest: $campaign_migration,
    researchMigrationDigest: $research_migration,
    registeredSchemaCount: $program[0].registeredSchemaCount,
    schemas: $program[0].schemas,
    fixtureArtifactContentCount: $program[0].fixtureArtifactContentCount,
    fixtureArtifacts: $program[0].fixtureArtifacts,
    fixtureArtifactDag: $program[0].fixtureArtifactDag,
    fixtureDecisionLedger: $program[0].fixtureDecisionLedger,
    fixtureCampaignBundle: $program[0].fixtureCampaignBundle,
    fixtureResearchProposal: $program[0].fixtureResearchProposal,
    attainedCapabilities: [
      "exact_fixture_program_restart",
      "exact_fixture_schema_catalog_restart",
      "exact_fixture_artifact_content_restart",
      "exact_fixture_artifact_dag_restart",
      "exact_fixture_decision_ledger_restart",
      "exact_fixture_campaign_bundle_restart",
      "exact_fixture_research_proposal_restart"
    ],
    qualification: {
      wave5GatesResolved: false,
      operationalRelease: false,
      fixtureArtifactDagOccurrence: true,
      fixtureDispositionOccurrence: true,
      fixtureCampaignBundleOccurrence: true,
      prospectiveCampaignJournal: false,
      fixtureResearchProposalOccurrence: true,
      humanResearchReview: false,
      proposalExecuted: false,
      researchResult: false,
      empiricalArtifactOccurrence: false,
      humanApproval: false,
      empiricalClaim: false,
      providerIo: false,
      externalMutation: false,
      productQualified: false,
      liveQualified: false
    },
    claim: "fixture_program_schema_evaluation_content_dag_dispositions_atomic_campaign_bundle_and_non_executable_research_proposal_only"
  }
' > "$JOSHI_W6_STATE/wave6-foundation-witness.json"

cat "$JOSHI_W6_STATE/wave6-foundation-witness.json"
